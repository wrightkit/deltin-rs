// license: MIT
// expect: ok
// note: minimized from the complete Jump-pad pathfinding project; preserves named Workshop arguments and classic formatted text.
globalvar define lastDummyBot;

rule: "Controls hud" {
    CreateHudText(
        AllPlayers(),
        Location: Location.Top,
        SortOrder: 0.5,
        Text: <"Current Segment: <0>", Pathmap.CurrentSegmentAttribute(lastDummyBot)>,
        TextColor: Color.Orange
    );
}
